{
  "name": "@tokenfault/testing",
  "version": "0.1.0",
  "description": "Helpers for testing AI streaming clients against TokenFault: start the mock LLM and proxy in-process, run streaming requests and get inspected results.",
  "license": "MIT",
  "author": "mohamed-bal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamed-bal/Token-Fault.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/mohamed-bal/Token-Fault#readme",
  "bugs": {
    "url": "https://github.com/mohamed-bal/Token-Fault/issues"
  },
  "keywords": [
    "tokenfault",
    "testing",
    "sse",
    "openai",
    "streaming",
    "fault-injection"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tokenfault/core": "workspace:*",
    "@tokenfault/mock-llm": "workspace:*",
    "@tokenfault/proxy": "workspace:*",
    "@tokenfault/shared": "workspace:*"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
