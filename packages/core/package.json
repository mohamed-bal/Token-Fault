{
  "name": "@tokenfault/core",
  "version": "0.1.0",
  "description": "TokenFault streaming engine: incremental SSE decoder, OpenAI chat-completions interpreter, stream metrics, deterministic fault engine, recording and replay.",
  "license": "MIT",
  "author": "mohamed-bal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamed-bal/Token-Fault.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/mohamed-bal/Token-Fault#readme",
  "bugs": {
    "url": "https://github.com/mohamed-bal/Token-Fault/issues"
  },
  "keywords": [
    "tokenfault",
    "sse",
    "server-sent-events",
    "openai",
    "streaming",
    "fault-injection",
    "replay"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tokenfault/shared": "workspace:*",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
