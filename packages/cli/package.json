{
  "name": "tokenfault",
  "version": "0.1.0",
  "private": true,
  "description": "TokenFault CLI: inspect, replay, break and harden AI streaming applications.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tokenfault": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && node ../../scripts/chmod-bin.mjs dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tokenfault/core": "workspace:*",
    "@tokenfault/mock-llm": "workspace:*",
    "@tokenfault/proxy": "workspace:*",
    "@tokenfault/shared": "workspace:*",
    "@tokenfault/studio": "workspace:*",
    "zod": "^4.6.5"
  }
}
