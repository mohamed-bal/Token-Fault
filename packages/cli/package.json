{
  "name": "tokenfault",
  "version": "0.1.0",
  "description": "TokenFault CLI: inspect, replay, break and harden AI streaming applications.",
  "license": "MIT",
  "author": "mohamed-bal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamed-bal/Token-Fault.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/mohamed-bal/Token-Fault#readme",
  "bugs": {
    "url": "https://github.com/mohamed-bal/Token-Fault/issues"
  },
  "keywords": [
    "tokenfault",
    "cli",
    "sse",
    "openai",
    "streaming",
    "debugging",
    "fault-injection",
    "observability",
    "llm"
  ],
  "type": "module",
  "bin": {
    "tokenfault": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "studio"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && node ../../scripts/chmod-bin.mjs dist/bin.js && node ../../scripts/copy-studio.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tokenfault/core": "workspace:*",
    "@tokenfault/mock-llm": "workspace:*",
    "@tokenfault/proxy": "workspace:*",
    "@tokenfault/shared": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tokenfault/studio": "workspace:*"
  }
}
